<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DreamScape_Interactive.Pages.CatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DreamScape_Interactive.Pages"
    xmlns:models="using:DreamScape_Interactive.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Item Catalogus"
                   Style="{StaticResource TitleTextBlockStyle}"
                   Margin="0,0,0,16" />

        <!-- Item List -->
        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind Items}"
                  SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Item">
                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Name, Description, Type, MagicProperties -->
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="{x:Bind Name}"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{x:Bind Description}"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{x:Bind Type}"
                                               Foreground="White"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                </Border>
                                <TextBlock Text="{x:Bind MagicProperties}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Right: Stats grid -->
                        <Grid Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>

                            <!-- Zeldzaamheid -->
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Zeldzaamheid"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                            <ProgressBar Grid.Row="0" Grid.Column="1"
                                         Value="{x:Bind Rarity}"
                                         Maximum="100"
                                         VerticalAlignment="Center" />

                            <!-- Kracht -->
                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="Kracht"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Margin="0,4,0,0" />
                            <ProgressBar Grid.Row="1" Grid.Column="1"
                                         Value="{x:Bind Power}"
                                         Maximum="100"
                                         VerticalAlignment="Center"
                                         Margin="0,4,0,0" />

                            <!-- Snelheid -->
                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="Snelheid"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Margin="0,4,0,0" />
                            <ProgressBar Grid.Row="2" Grid.Column="1"
                                         Value="{x:Bind Speed}"
                                         Maximum="100"
                                         VerticalAlignment="Center"
                                         Margin="0,4,0,0" />

                            <!-- Duurzaamheid -->
                            <TextBlock Grid.Row="3" Grid.Column="0"
                                       Text="Duurzaamheid"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Margin="0,4,0,0" />
                            <ProgressBar Grid.Row="3" Grid.Column="1"
                                         Value="{x:Bind Durability}"
                                         Maximum="100"
                                         VerticalAlignment="Center"
                                         Margin="0,4,0,0" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
